# =========================================================================== #
#  Goao_iwo9 — shared Rubika subscription service (two separate bots).
#  Copy to .env and fill in. Run TWO processes:
#     MODE=owner    python main.py     (central panel — only you)
#     MODE=customer python main.py     (customer subscription bot)
# =========================================================================== #

# Which role THIS process runs as: owner | customer | worker
MODE=owner

# ---- Telegram API (shared; from https://my.telegram.org) ----
API_ID=
API_HASH=

# ---- Two SEPARATE bot tokens (full isolation) ----
# Owner panel bot token (only the owner uses it)
OWNER_BOT_TOKEN=
# Customer subscription bot token
CUSTOMER_BOT_TOKEN=

# Your numeric Telegram id (the single owner)
OWNER_ID=
# Central log group id (add BOTH bots to the group first)
LOG_GROUP_ID=

# Version label shown in the startup "Online" log
VERSION=V1

# ---- Subscription plan prices (USD) ----
PRICE_3DAY=5
PRICE_WEEKLY=8
PRICE_MONTHLY=20
# Warn the customer this many days before expiry
EXPIRY_WARN_DAYS=2

# ---- TRON / TronGrid (TRX native payment verification) ----
# Your receiving wallet (customers pay here)
WALLET_ADDRESS=
# TronGrid API key
TRON_API_KEY=
TRONGRID_BASE=https://api.trongrid.io
# Payment tolerance (percent). Accepts if actual >= expected * (1 - tolerance/100)
PAYMENT_TOLERANCE_PERCENT=5
# CoinGecko TRX/USD price cache lifetime (seconds). Default 5 minutes.
COINGECKO_CACHE_SECONDS=300
# Manual TRX price override (USD). 0 = use CoinGecko live price.
TRX_PRICE_OVERRIDE=0

# ---- Security ----
# Anti-flood: more than RATE_LIMIT_MAX actions / RATE_LIMIT_WINDOW seconds
# => the customer is auto-blocked and it is logged.
RATE_LIMIT_MAX=35
RATE_LIMIT_WINDOW=120
# Anti-tamper clock: ignore wall-clock rewinds bigger than this (seconds)
CLOCK_BACKWARD_TOLERANCE=120

# ---- Maintenance + automatic backup ----
MAINTENANCE_DEFAULT=false
# Automatic system backup interval (seconds). 0 disables. 21600 = 6h.
BACKUP_INTERVAL=21600

# ---- At-rest encryption key (REQUIRED) ----
# Encrypts worker SSH creds/tokens (and is the project's secret).
# Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKER_SECRET=

# ---- Sending behaviour (reused logic) ----
SEND_DELAY=1.0
FORWARD_MARKER=کد135
MAX_ERRORS=3

# ---- Worker subsystem (optional; single server works without workers) ----
MASTER_AS_WORKER=true
GIT_REPO_URL=https://github.com/willbedoneuw/Goao_iwo9
GIT_BRANCH=main
WORKER_API_PORT=8765
WORKER_API_TOKEN=
HEALTH_URL=https://upmessenger490.iranlms.ir/UploadFile.ashx
HEALTH_INTERVAL=1800
PING_GREEN_MS=800
PING_YELLOW_MS=2000

# All log timestamps use this timezone
TIMEZONE=Asia/Tehran

# ---- Tools section + Rubika contact-builder (customer-bot update) ----
# Per-user DAILY caps (reset at local midnight in TIMEZONE).
NUMGEN_DAILY_CAP=8000          # Tools » Iranian number generator (numbers/day/user)
RB_CONTACT_DAILY_CAP=300       # Rubika » build contacts by prefix (contacts/day/user)
# First name given to every contact added to the address book.
CONTACT_DEFAULT_FIRST=Friend
# Contact-builder tuning.
CONTACT_ADD_DELAY=0.2          # seconds between probes
CONTACT_MAX_ERRORS=5           # consecutive-error brake
CONTACT_RESUME_WAIT=60         # pause seconds after the brake trips
CONTACT_PROGRESS_EVERY=3.0     # live-card refresh interval (seconds)
CONTACT_REMOTE_CHUNK=20        # numbers per remote /contacts/add call
CONTACT_ATTEMPT_FACTOR=40      # max probes ~= target * this
# APK -> ZIP tool: max accepted APK size (MB).
APK_ZIP_MAX_MB=200
